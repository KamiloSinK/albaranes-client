{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "api-types/src/index.d.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@coa/api-types": [
        "./api-types/src/index.d.ts"
      ]
    },
    "typeRoots": [
      "node_modules/@types",
      "api-types/src",
      "src/types"
    ]
  }
}
